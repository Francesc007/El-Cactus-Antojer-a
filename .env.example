# Copiar a .env.local. Nunca commitear secretos reales.

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Solo servidor. Nunca NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# WhatsApp. Número en formato internacional sin + ni espacios.
WHATSAPP_BUSINESS_NUMBER=527731491349
# wa_me | whatsapp_cloud
NOTIFICATION_PROVIDER=wa_me

# WhatsApp Cloud API (solo cuando Meta apruebe plantillas)
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_TEMPLATE_CUSTOMER=
WHATSAPP_CLOUD_TEMPLATE_OWNER=
WHATSAPP_CLOUD_OWNER_PHONE=
# Cumpleaños, categoría Marketing. Un parámetro: el primer nombre.
# Hola {{1}}, ¡feliz cumpleaños! 🎉 En El Cactus queremos celebrarlo contigo. Ven y disfruta con nosotros. ¡Te esperamos!
WHATSAPP_CLOUD_TEMPLATE_BIRTHDAY=
# Aviso del lunes al dueño. {{1}} cantidad, {{2}} primeros nombres.
# Esta semana hay {{1}} cumpleaños en El Cactus: {{2}}.
WHATSAPP_CLOUD_TEMPLATE_BIRTHDAY_WEEKLY=
# Secreto del cron de Vercel. El cron no llama a Meta si NOTIFICATION_PROVIDER=wa_me.
CRON_SECRET=
BUSINESS_TIMEZONE=America/Mexico_City
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Observabilidad opcional
SENTRY_DSN=

# Límite de reservas públicas por IP / ventana
RESERVATION_RATE_LIMIT_MAX=8
RESERVATION_RATE_LIMIT_WINDOW_MINUTES=15
